# ============================================================
# DELO — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit real secret keys into Git!
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE (Database & Authentication)
# ------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key with admin privileges (for backend bot and webhook services)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# 2. OPENAI (Task Extraction & Whisper Audio STT)
# ------------------------------------------------------------
# Found in OpenAI Platform -> API Keys
OPENAI_API_KEY=sk-proj-...

# ------------------------------------------------------------
# 3. TELEGRAM BOT
# ------------------------------------------------------------
# Obtained from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Telegram bot username without @ (e.g. delo_task_bot)
TELEGRAM_BOT_USERNAME=delo_task_bot
# Secret token to authenticate Telegram webhook requests in production
TELEGRAM_WEBHOOK_SECRET=random_secure_webhook_secret_string

# ------------------------------------------------------------
# 4. APPLICATION URLS & CONFIG
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_USER_TIMEZONE=Europe/Chisinau
